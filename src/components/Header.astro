---
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import BrandTitle from './SiteTitle.astro';
const signupUrl = 'https://www.dassi.ai/?signup=1&utm_source=dassi_docs&utm_medium=referral&utm_campaign=docs_header';
const installUrl = 'https://chromewebstore.google.com/detail/dassi-ai-browser-agent/bjcngahpcjeililljmfegmlanlpgibdi?utm_source=dassi_docs&utm_medium=referral&utm_campaign=docs_header&utm_content=install';
---
<div class="docs-header">
  <div class="brand"><BrandTitle /></div>
  <div class="search"><Search /></div>
  <div class="social"><SocialIcons /></div>
  <nav class="actions" aria-label="Get started with Dassi">
    <a class="signup" href={signupUrl}>Sign up</a>
    <a class="install" href={installUrl} target="_blank" rel="noopener noreferrer"><span class="full">Install dassi</span><span class="short">Install</span></a>
  </nav>
  <LanguageSelect />
</div>
<style>
.docs-header{display:flex;align-items:center;gap:1rem;height:100%;min-width:0}
.brand{min-width:0;margin-right:auto}
.search{flex:1;max-width:22rem;min-width:0}
.social{display:flex;gap:1rem;align-items:center}
.actions{display:flex;gap:.6rem;align-items:center;flex-shrink:0}
.actions a{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:.5rem .85rem;border-radius:6px;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap}
.signup{color:#111;border:1px solid #ccc;background:#fff}
.install{color:#fff;background:#171717;border:1px solid #171717}
.signup:hover{background:#f5f5f5}.install:hover{background:#333}
.actions a:focus-visible{outline:2px solid #b74300;outline-offset:3px}
.short{display:none}
@media(max-width:72rem){.social{display:none}}
@media(max-width:50rem){.docs-header{gap:.5rem}.search{flex:0 0 auto}.actions{gap:.35rem}.actions a{padding:.4rem .55rem;font-size:12px}.full{display:none}.short{display:inline}.brand :global(.logo-text),.brand :global(.logo-divider),.brand :global(.docs-link){display:none}}
@media print{.search,.social,.actions{display:none}}
</style>
